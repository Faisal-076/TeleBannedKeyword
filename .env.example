# ============================================================================
# Telegram Message Analyzer — environment template
# Copy to `.env` locally (never commit .env). On Railway / Northflank, set
# these as secrets (see NORTHFLANK.md for a step-by-step managed deploy).
# ============================================================================

# ---- Core ----------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# "full" = include event payloads (no message content by default).
# "medium" = include operation/chat ids. "minimal" = only redacted ids.
LOG_PRIVACY_LEVEL=medium

# ---- Telegram Bot API ----------------------------------------------------
# From @BotFather. NEVER commit or share.
BOT_TOKEN=

# Comma-separated numeric Telegram user IDs allowed to use the bot.
ADMIN_USER_IDS=

# ---- Admin HTTP API ------------------------------------------------------
# Long random string protecting /api/v1/admin/* endpoints (Authorization: Bearer).
ADMIN_API_KEY=

# ---- Telegram MTProto (scanner account) -----------------------------------
# From https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Master secret used to encrypt the Telethon session (AES-256-GCM via HKDF).
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# If empty, encryption key derivation is disabled and session must be absent.
MASTER_SECRET=

# One of:
#  SESSION_ENC=<encrypted session blob produced by `tbk-auth`>   (preferred)
#  SESSION_FILE=/data/session.enc  (encrypted session file on a persistent volume)
SESSION_ENC=
SESSION_FILE=

# ---- Database / Redis ----------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tbk
REDIS_URL=redis://localhost:6379/0
# Northflank: use the internal hostnames + rediss:// for TLS Redis, e.g.
#   DATABASE_URL=postgresql+asyncpg://user:pass@postgres.internal:5432/tbk?ssl=require
#   REDIS_URL=rediss://:password@redis.internal:6379/0?ssl_cert_reqs=none

# ---- Deployment -----------------------------------------------------------
# true = create schema on process start (local dev). Set false on managed
# deployments (docker compose / Northflank): the image entrypoint runs
# `alembic upgrade head` instead.
AUTO_CREATE_SCHEMA=true
# In the container entrypoint: wait up to N seconds for the DB, then migrate.
# MIGRATE_ON_STARTUP=1 can be set to 0 when another process owns migrations.
DB_MAX_WAIT_SECONDS=120

# ---- Analysis engine -------------------------------------------------------
MAX_MESSAGE_CHARS=4000
FUZZY_THRESHOLD=0.88
HISTORY_SEARCH_LIMIT=50
DATA_RETENTION_DAYS=90
REQUIRE_COVERAGE_FOR_UNSEEN=true

# ---- LLM (optional; "disabled" ships no AI analysis) -----------------------
# LLM_PROVIDER: disabled | deepseek | openai_compatible
LLM_PROVIDER=disabled
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# ---- Indexing / sync -------------------------------------------------------
INITIAL_SYNC_BATCH=500
INITIAL_SYNC_MAX_MESSAGES=200000
INCREMENTAL_SYNC_BATCH=500

# ---- MTProto rate limiting --------------------------------------------------
MT_PROTO_MAX_CONCURRENCY=3
MT_PROTO_CHAT_MIN_INTERVAL=0.6
MT_PROTO_FLOOD_SLEEP_THRESHOLD=60
MT_PROTO_MAX_FLOOD_SLEEP=3600
MT_PROTO_RETRY_LIMIT=5

# ---- API server -------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
